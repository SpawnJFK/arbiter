#!/bin/sh
# Arbiter pre-push: soft and loud. Never blocks a push (always exit 0).
# Graphify index freshness, then Beads export staleness.
set +e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export GITHOOK_ROOT="$ROOT"
. "$ROOT/scripts/githook-locate-node.sh"
. "$ROOT/scripts/githook-locate-graphify.sh"

run_mjs() {
  label=$1
  script=$2
  if [ ! -f "$script" ]; then
    printf '[githook] pre-push skipped %s: missing %s\n' "$label" "${script#"$ROOT"/}" >&2
    return 0
  fi
  if [ -z "$GIT_HOOK_NODE" ]; then
    printf '[githook] pre-push skipped %s: node not found (fnm/.node-version); hook guards inactive\n' "$label" >&2
    return 0
  fi
  GIT_HOOK_GRAPHIFY="$GIT_HOOK_GRAPHIFY" "$GIT_HOOK_NODE" "$script"
  return 0
}

run_mjs graphify "$ROOT/scripts/graphify-pre-push-hook.mjs"
run_mjs beads "$ROOT/scripts/beads-pre-push-hook.mjs"

exit 0
