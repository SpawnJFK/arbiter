# Arbiter environment template.
#   Production: copy to deploy/.env (docker compose reads it from there).
#   Local dev:  copy to services/api/.env (pydantic-settings reads .env from the working dir).
# Never commit a filled-in copy. Secrets have no defaults on purpose.

# ---------------------------------------------------------------- deploy (compose, Caddy)
# Root domain without prefix. Caddy serves app.<DOMAIN> (web) and api.<DOMAIN> (API).
DOMAIN=
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=
# Postgres superuser password for the compose stack. openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# Image tag used by compose (latest, or a git sha/tag for rollbacks).
ARBITER_IMAGE_TAG=latest

# ---------------------------------------------------------------- web (Next.js)
# API origin (without /v1). Only the Next server calls it; the browser goes through /api/proxy.
# Empty in production compose = https://api.<DOMAIN>. Local dev: http://localhost:8000
NEXT_PUBLIC_API_URL=
# Runtime override of the API origin for the web container (e.g. http://api:8000 inside compose).
API_URL=
# 1 = web app answers from built-in fixtures, no backend (demos only). Inlined at build time.
NEXT_PUBLIC_API_MOCK=0

# ---------------------------------------------------------------- API + worker (ARBITER_*)
# dev | test | staging | prod
ARBITER_ENV=dev
# SQLAlchemy URL. Compose builds this itself from POSTGRES_PASSWORD; set it only for local runs.
ARBITER_DATABASE_URL=postgresql+psycopg://arbiter:arbiter@localhost:5432/arbiter
# pytest database (tests/conftest.py). Never point this at a database you care about: it is dropped.
ARBITER_TEST_DATABASE_URL=postgresql+psycopg://arbiter:arbiter@localhost:5432/arbiter_test
# Where uploaded source files, translated outputs and evidence PDFs are written.
ARBITER_STORAGE_DIR=./var/storage
# Absolute URL the API uses in links it generates (downloads, webhooks, evidence).
ARBITER_PUBLIC_BASE_URL=http://localhost:8000
# Browser origins allowed by CORS, comma separated (direct API calls; the web app goes
# through its own server proxy). Production: https://app.<DOMAIN>
ARBITER_CORS_ORIGINS=http://localhost:3000
# Run "alembic upgrade head" in the container entrypoint (1 on the api service only).
ARBITER_MIGRATE_ON_START=0

# Auth. JWT signing secret, at least 32 characters. The API refuses to start in prod while it
# still starts with "dev-only". Generate: openssl rand -hex 48
ARBITER_JWT_SECRET=dev-only-change-me-not-for-production-use-not-for-production-use
# Session token lifetime in minutes (default 12 h).
ARBITER_JWT_TTL_MINUTES=720

# Providers. Empty = provider unavailable, the router skips it. Mock providers always exist.
ARBITER_ANTHROPIC_API_KEY=
ARBITER_ANTHROPIC_MODEL=claude-opus-5-5
ARBITER_OPENAI_API_KEY=
ARBITER_OPENAI_MODEL=gpt-5
ARBITER_DEEPL_API_KEY=
ARBITER_GOOGLE_API_KEY=
# mock | openai (TM semantic matches via pgvector)
ARBITER_EMBEDDING_PROVIDER=mock

# Engines used when the scoreboard has no data for a language pair (R-MT-02).
ARBITER_DEFAULT_MT_ENGINE=mock-mt
ARBITER_DEFAULT_JUDGE_ENGINE=mock-llm

# Quality defaults (per org/content_type/target_lang thresholds override these).
# QE score at or above which a segment may auto-approve (0-100).
ARBITER_DEFAULT_THRESHOLD=78.0
# Senate is convened for threshold - band_width < score < threshold + band_width.
ARBITER_BAND_WIDTH=8.0
# Share of auto-approved segments sent blind to human control review.
ARBITER_CONTROL_SAMPLE_RATE=0.02
# Calibration may move a threshold by at most this many points per week.
ARBITER_MAX_THRESHOLD_STEP_PER_WEEK=3.0
# Target escaped-error rate on auto-approved segments (0.005 = 0.5%).
ARBITER_ESCAPED_ERROR_TARGET=0.005
# Drift alarm fires when the auto-approve rate moves by more than this ratio vs baseline.
ARBITER_DRIFT_ALARM_RATIO=0.30

# Money (all amounts are Decimal, never float).
ARBITER_CURRENCY=EUR
ARBITER_QUOTE_VALIDITY_DAYS=14
# Invoices (D-029, starting rule; legal and tax review before public launch).
# Seller country, ISO 3166 alpha-2. Empty = unknown: no reverse-charge decision is made.
ARBITER_SELLER_COUNTRY=
# VAT rate as a decimal string (e.g. "0.20"); default 0.
ARBITER_VAT_RATE=0

# Webhooks
ARBITER_WEBHOOK_MAX_ATTEMPTS=10
ARBITER_WEBHOOK_DISABLE_AFTER_CONSECUTIVE_FAILURES=500

# API limits
ARBITER_RATE_LIMIT_PER_MINUTE=6000
ARBITER_PAGE_SIZE_MAX=200

# ---------------------------------------------------------------- backups (deploy/backup.sh)
# rclone remote:path for off-site copies. Empty = local only.
RCLONE_REMOTE=
BACKUP_DIR=/var/backups/arbiter
LOCAL_RETENTION_DAYS=7
REMOTE_RETENTION_DAYS=30
BACKUP_STORAGE=1

# CORS origins allowed to call the API (comma separated)
ARBITER_CORS_ORIGINS=http://localhost:3000
# Seller country (ISO 3166-1 alpha-2) and default VAT rate for invoices.
# Tax treatment must pass legal/tax review before public launch.
ARBITER_SELLER_COUNTRY=
ARBITER_VAT_RATE=0
