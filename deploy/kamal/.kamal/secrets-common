ARBITER_S3_SECRET_ACCESS_KEY=$ARBITER_S3_SECRET_ACCESS_KEY

ARBITER_MAIL_FROM=$ARBITER_MAIL_FROM
ARBITER_SMTP_HOST=$ARBITER_SMTP_HOST
ARBITER_SMTP_USERNAME=$ARBITER_SMTP_USERNAME
ARBITER_SMTP_PASSWORD=$ARBITER_SMTP_PASSWORD

ARBITER_ANTHROPIC_API_KEY=$ARBITER_ANTHROPIC_API_KEY
