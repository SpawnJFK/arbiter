# Arbiter web app. Copy to .env.local for local development.

# Backend origin (the app appends /v1). Only the Next server calls it; the browser never does.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional runtime override for the backend origin (e.g. http://api:8000 inside Docker Compose).
# Wins over NEXT_PUBLIC_API_URL, which is inlined at build time.
API_URL=

# 1 = serve fixture data from src/lib/mock instead of calling the API (demo without backend).
# Inlined at build time: set it for `npm run build` as well as `npm start`.
NEXT_PUBLIC_API_MOCK=0
